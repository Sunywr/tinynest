# Sample settings only. Replace values on backend host B. NEVER commit real secrets.
# Server B API binds to loopback ONLY; backend Nginx terminates internal TLS.
TINYNEST_LISTEN_ADDR=127.0.0.1:8787
TINYNEST_DATA_DIR=/var/lib/tinynest
# TINYNEST_DB_PATH (optional, defaults to <data_dir>/tinynest.sqlite3)
# TINYNEST_DB_PATH=/var/lib/tinynest/tinynest.sqlite3

# --- One-time bootstrap (FIX-01) -------------------------------------------
# Generate a strong random value on host B, e.g. `openssl rand -hex 32`.
# Empty/unset => POST /api/v1/setup is DISABLED (fail closed).
# The token is consumed by the single successful initialization; never log it,
# never put it in browser code, never commit it.
TINYNEST_SETUP_TOKEN=

# --- Post-initialization shutdown -------------------------------------------
# Set to true ONLY after this instance has been initialized and the admin exists.
# true  => POST /api/v1/setup refuses EVERY request with 403 setup_disabled,
#          before any token check or database read (defense in depth).
# false / unset => a fresh offline deployment can still bootstrap once through
#          a controlled operator-side API call using TINYNEST_SETUP_TOKEN.
# Strictly parsed; any other value refuses to start.
# TINYNEST_SETUP_DISABLED=false

# --- Session cookie (FIX-04) -----------------------------------------------
# MUST be set explicitly to true or false; the server refuses to start otherwise.
# Production behind HTTPS reverse proxy: true. Local plain-HTTP dev: false.
TINYNEST_COOKIE_SECURE=false
# Only these proxy sources may set X-Forwarded-* (comma-separated IPs/CIDRs).
# TINYNEST_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# --- Failed-login throttling (FIX-05) --------------------------------------
# TINYNEST_LOGIN_MAX_FAILURES=5
# TINYNEST_LOGIN_WINDOW_SECONDS=300
# TINYNEST_LOGIN_LOCKOUT_SECONDS=60
